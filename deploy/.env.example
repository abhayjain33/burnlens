# Copy to deploy/.env (git-ignored) and edit. Docker Compose reads it automatically.

# Database password. Set once before the first start; changing it later
# does not change the existing database's password.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Host port for the dashboard and ingest API.
BURNLENS_PORT=8080

# 0.0.0.0 exposes the port on all interfaces. Behind a reverse proxy on the
# same host, use 127.0.0.1 so only the proxy can reach it.
BURNLENS_BIND=0.0.0.0

# 1 when served over HTTPS (marks the login cookie Secure).
BURNLENS_SECURE_COOKIE=0
