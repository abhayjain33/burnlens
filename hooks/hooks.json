{
  "description": "burnlens: push usage to your org server after each session (no-op unless configured)",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/burnlens.sh\" sync --background",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
